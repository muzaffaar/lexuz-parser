# Copy to ../.env (deploy/bootstrap.sh does this and generates every CHANGE_ME_* value). Never commit .env.

# --- Django (admin) ---
DJANGO_SECRET_KEY=CHANGE_ME_SECRET
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Public host name of this server. When set, run with the "proxy" profile for automatic HTTPS (see DEPLOY.md).
DOMAIN=
DJANGO_HTTPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# The admin is published on this LOOPBACK port only; reach it through an SSH tunnel or the proxy profile.
ADMIN_PORT=8000

# --- PostgreSQL (private network only, no published port) ---
POSTGRES_DB=yurist
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
OWNER_DB_PASSWORD=CHANGE_ME_OWNER
PARSER_DB_PASSWORD=CHANGE_ME_PARSER
API_DB_PASSWORD=CHANGE_ME_API

# --- Raw snapshot storage (S3 API; TZ 98). The bundled SeaweedFS is the default. ---
S3_BUCKET=yurist-raw
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS
S3_SECRET_KEY=CHANGE_ME_S3_SECRET
# Leave as is for the bundled store. For AWS S3 / another provider set its endpoint (empty = AWS) and its keys.
S3_ENDPOINT_URL=http://s3:8333

# Compose profiles that `docker compose up` should start in addition to the core stack: proxy
COMPOSE_PROFILES=
