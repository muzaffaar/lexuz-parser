# Crawler image: the only container with Internet access. It never touches PostgreSQL; it writes the archive to /data.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

COPY deploy/crawler-requirements.txt .
RUN pip install -r crawler-requirements.txt

COPY lex_crawler ./lex_crawler
RUN useradd --system --uid 10001 --home-dir /nonexistent app && mkdir /data && chown app /data
USER app
VOLUME /data
ENTRYPOINT ["python", "-m", "lex_crawler", "--data", "/data"]
CMD ["status"]
